version: "3.9"

services:

  app:
    build:
      context: .
      dockerfile: docker/php/Dockerfile
    container_name: sushako-app
    working_dir: /var/www/html
    volumes:
      - ./:/var/www/html
    depends_on:
      - mysql
      - redis
    networks:
      - sushako

  nginx:
    image: nginx:alpine
    container_name: sushako-nginx
    ports:
      - "80:80"
    volumes:
      - ./:/var/www/html
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - app
    networks:
      - sushako

  mysql:
    image: mysql:8.4
    container_name: sushako-mysql
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: sushako
      MYSQL_ROOT_PASSWORD: root
      MYSQL_USER: sushako
      MYSQL_PASSWORD: password
    ports:
      - "3306:3306"
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - sushako

  redis:
    image: redis:7-alpine
    container_name: sushako-redis
    ports:
      - "6379:6379"
    networks:
      - sushako

volumes:
  mysql_data:

networks:
  sushako:

