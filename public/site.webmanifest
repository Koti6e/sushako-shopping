    { "name": "Categories", "short_name": "Categories", "url": "/#categories", "icons": [{ "src": "/assets/brand/sushako-shopping-official-icon-192.png", "sizes": "192x192" }] },
    { "name": "Track Order", "short_name": "Track", "url": "/track-order", "icons": [{ "src": "/assets/brand/sushako-shopping-official-icon-192.png", "sizes": "192x192" }] },
    { "name": "Cart", "short_name": "Cart", "url": "/cart", "icons": [{ "src": "/assets/brand/sushako-shopping-official-icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    {
      "src": "/assets/brand/sushako-shopping-official-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/brand/sushako-shopping-official-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
